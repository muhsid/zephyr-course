menuconfig LED_SUBSYSTEM
	bool "LED Subsystem"
	default y

config APP_HEARTBEAT_PERIOD_MS
	int "App heartbeat period (ms)"
	default 500
	range 100 2000
	depends on LED_SUBSYSTEM
	help
	  How long the application heartbeat period should be, in milliseconds.

menuconfig LED_ADVANCED
	bool "Advanced LED settings"
	depends on LED_SUBSYSTEM

config LED_BRIGHTNESS
	int "LED brightness (0-100)"
	default 100
	range 0 100
	depends on LED_ADVANCED

config LED_FADE_DURATION_MS
	int "LED fade duration (ms)"
	default 500
	range 0 10000
	depends on LED_ADVANCED

menu "Expert settings"
	depends on LED_ADVANCED

config LED_DEBUG
	bool "Enable LED debugging"

config LED_CUSTOM_PATTERN
	bool "Custom blink pattern"

endmenu

source "Kconfig.zephyr"